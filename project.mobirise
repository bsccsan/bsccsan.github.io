        "main": true,
        "title": "BscScan - BNB Chain Explorer",
        "meta_descr": "Explore BscScan, the leading blockchain explorer for BNB Chain. Learn how to track transactions, verify smart contracts, monitor wallets, and analyze crypto data in real time.",
        "header_custom": "",
        "footer_custom": "",
